{
  "name": "otome-translator",
  "version": "1.4.0",
  "private": true,
  "description": "Otome Translator (OTM) - desktop app for translating Otomate / Idea Factory games",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/catalog-otomate.js && node --check src/catalog-unity.js && node --check src/engines.js && node --check src/update-check.js && node --check src/update-ui.js",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.vees.desktop",
    "productName": "Otome Translator",
    "files": [
      "src/**/*",
      "engines/**/*",
      "!engines/**/__pycache__",
      "assets/**/*",
      "requirements.txt",
      "README.md",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "OTM-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "OTM-${version}-${arch}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
